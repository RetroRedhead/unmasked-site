---
layout: layout.njk
permalink: /quiz/index.html
pageTitle: "The Sensory Score | The Unmasked Standard"
---
<header class="hero hero-short">
  <div class="halo" aria-hidden="true"></div>
  <div class="wrap">
    <p class="eyebrow">{{ quiz.eyebrow }}</p>
    <h1 class="h1-short">{{ quiz.heading }}</h1>
    <p class="lede">{{ quiz.intro }}</p>
  </div>
</header>

<section class="quiz-sec">
  <div class="wrap wrap-narrow">
    <p class="quiz-instruction">{{ quiz.instruction }}</p>

    <form id="quiz" novalidate>
      {% for q in quiz.questions %}
      {% set qi = loop.index0 %}
      <fieldset class="q" data-q="{{ qi }}">
        <legend><span class="q-num">{{ loop.index }}</span>{{ q.prompt }}</legend>
        {% for o in q.options %}
        <label class="opt">
          <input type="radio" name="q{{ qi }}" value="{{ o.score }}">
          <span>{{ o.text }}</span>
        </label>
        {% endfor %}
      </fieldset>
      {% endfor %}
    </form>

    <div class="quiz-bar" id="quizbar" aria-live="polite">
      <div class="quiz-progress"><span id="progressfill"></span></div>
      <p id="progresstext">0 of {{ quiz.questions | length }} answered</p>
      <button class="btn btn-primary" id="scorebtn" type="button" disabled>See my score</button>
    </div>

    <div id="result" class="result" hidden tabindex="-1">
      <p class="eyebrow" id="resultband"></p>
      <div class="result-score"><span id="resultnum"></span><small>out of 20</small></div>
      <h2 id="resulthead"></h2>
      <p id="resultbody"></p>
      <p class="result-next" id="resultnext"></p>

      <div class="capture-card capture-inline">
        <div>
          <h3>{{ quiz.captureHeading }}</h3>
          <p>{{ quiz.captureBody }}</p>
        </div>
        <form action="{{ quiz.captureAction }}" method="post">
          <label for="qemail">Where should we send it</label>
          <input type="email" id="qemail" name="email" placeholder="you@yoursalon.com" autocomplete="email" required>
          <input type="hidden" name="sensory_band" id="bandfield" value="">
          <input type="hidden" name="sensory_score" id="scorefield" value="">
          <button class="btn btn-primary" type="submit">{{ quiz.captureButton }}</button>
          <p class="fineprint">{{ quiz.captureFineprint }}</p>
        </form>
      </div>
    </div>
  </div>
</section>

<script id="bands" type="application/json">{{ quiz.bands | dump | safe }}</script>
<script src="/css/quiz.js"></script>
