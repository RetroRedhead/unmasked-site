---
layout: layout.njk
---
<header class="hero" id="top">
  <div class="halo" aria-hidden="true"></div>
  <div class="wrap">
    <p class="eyebrow">{{ home.eyebrow }}</p>
    <h1>{{ home.heading }} <em>{{ home.headingEmphasis }}</em>.</h1>
    <p class="lede">{{ home.lede }}</p>

    <div class="doors">
      {% for d in home.doors %}
      <button type="button" class="door door-{{ d.key }}" data-door="{{ d.key }}" aria-pressed="{{ 'true' if loop.first else 'false' }}">
        <span class="door-tag">{{ d.tag }}</span>
        <h2>{{ d.title }}</h2>
        <p>{{ d.body }}</p>
        <span class="go">{{ d.cta }}
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
      </button>
      {% endfor %}
    </div>
  </div>
</header>

<div class="proof">
  <div class="proof-in">
    {% for p in home.proof %}
    <div class="proof-stat"><b>{{ p.figure }}</b><span>{{ p.label }}</span></div>
    {% endfor %}
  </div>
</div>

<section id="standard">
  <div class="wrap">
    <div class="sec-head">
      <p class="eyebrow">{{ home.standardEyebrow }}</p>
      <h2>{{ home.standardHeading }}</h2>
      <p>{{ home.standardIntro }}</p>
    </div>
    <div class="pillars">
      {% for p in home.pillars %}
      <div class="pillar">
        <div class="rule"></div>
        <h3>{{ p.title }}</h3>
        <p>{{ p.body }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="path" id="start">
  <div class="wrap">
    <div class="sec-head">
      <p class="eyebrow">{{ home.startEyebrow }}</p>
      <h2>{{ home.startHeading }}</h2>
      <p>{{ home.startIntro }}</p>
    </div>

    <div class="path-switch" role="group" aria-label="Choose your path">
      <button type="button" data-door="stylist" aria-pressed="true">{{ home.paths.stylist.switchLabel }}</button>
      <button type="button" data-door="owner" aria-pressed="false">{{ home.paths.owner.switchLabel }}</button>
    </div>

    {% for key, path in home.paths %}
    <div class="path-panel" data-panel="{{ key }}"{% if key != "stylist" %} hidden{% endif %}>
      <div class="steps">
        {% for s in path.steps %}
        <div class="step{% if s.featured %} featured{% endif %}">
          <div class="price">{{ s.price }}{% if s.priceNote %} <small>{{ s.priceNote }}</small>{% endif %}</div>
          <h3>{{ s.title }}</h3>
          <p>{{ s.body }}</p>
          <ul>
            {% for b in s.bullets %}<li>{{ b }}</li>{% endfor %}
          </ul>
          <a class="btn {{ 'btn-primary' if s.featured else 'btn-secondary' }}" href="{{ s.ctaUrl }}">{{ s.ctaLabel }}</a>
        </div>
        {% endfor %}
      </div>
      <p class="note">{{ path.note }}</p>
    </div>
    {% endfor %}
  </div>
</section>

<section class="capture" id="audit">
  <div class="wrap">
    <div class="capture-card">
      <div>
        <p class="eyebrow">{{ home.captureEyebrow }}</p>
        <h2>{{ home.captureHeading }}</h2>
        <p>{{ home.captureBody }}</p>
      </div>
      <form action="{{ home.captureAction }}" method="post">
        <label for="email">Where should we send it</label>
        <input type="email" id="email" name="email" placeholder="you@yoursalon.com" autocomplete="email" required>
        <button class="btn btn-primary" type="submit">{{ home.captureButton }}</button>
        <p class="fineprint">{{ home.captureFineprint }}</p>
      </form>
    </div>
  </div>
</section>

<section class="founder">
  <div class="wrap founder-grid">
    <blockquote>{{ home.founderQuote }}</blockquote>
    <div>
      {% for para in home.founderBody.split("\n\n") %}<p>{{ para }}</p>{% endfor %}
      <p class="attrib">{{ home.founderAttrib }}</p>
    </div>
  </div>
</section>
